---
/**
 * The mcp-pulse mark: the pulse line from the favicon, orange at rest. On
 * hover a trace in ink draws over it left to right and fades out again, and
 * it always runs to the end: a few lines of script start the keyframes on
 * pointer entry and clear them when they finish, so leaving halfway changes
 * nothing. People who asked for less motion see the orange line only.
 */
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
const points = '3,17 10,17 13,9 17,24 20,14 22,17 29,17';
---

<svg class={`pulse ${cls}`} viewBox="0 0 32 32" fill="none" stroke-width="2.6" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
  <polyline class="base" points={points}></polyline>
  <polyline class="trace" points={points} pathLength="100"></polyline>
</svg>
