---
/**
 * A wordmark built from 5 px bars in one span, the way ULEHLA is built on
 * ulehla.dev: one gradient layer per bar, no font, no script. Each letter
 * sits on a 15 × 25 grid with bars at x 0/5/10 and y 0/10/20.
 */
interface Props {
  text: string;
  class?: string;
}
const { text, class: cls = '' } = Astro.props;

type Bar = [x: number, y: number, w: number, h: number];
const LETTERS: Record<string, { bars: Bar[]; advance: number }> = {
  M: { bars: [[0, 0, 5, 25], [10, 0, 5, 25], [0, 0, 15, 5], [5, 0, 5, 10]], advance: 20 },
  C: { bars: [[0, 0, 5, 25], [0, 0, 15, 5], [0, 20, 15, 5]], advance: 20 },
  P: { bars: [[0, 0, 5, 25], [0, 0, 15, 5], [0, 10, 15, 5], [10, 0, 5, 15]], advance: 20 },
  U: { bars: [[0, 0, 5, 25], [10, 0, 5, 25], [0, 20, 15, 5]], advance: 20 },
  L: { bars: [[0, 0, 5, 25], [0, 20, 15, 5]], advance: 20 },
  S: { bars: [[0, 0, 15, 5], [0, 0, 5, 15], [0, 10, 15, 5], [10, 10, 5, 15], [0, 20, 15, 5]], advance: 20 },
  E: { bars: [[0, 0, 5, 25], [0, 0, 15, 5], [0, 10, 15, 5], [0, 20, 15, 5]], advance: 20 },
  '-': { bars: [[0, 10, 10, 5]], advance: 15 },
  ' ': { bars: [], advance: 10 }
};

const bars: Bar[] = [];
let x = 0;
for (const ch of text.toUpperCase()) {
  const letter = LETTERS[ch];
  if (!letter) throw new Error(`BarMark has no letter "${ch}"`);
  for (const [bx, by, w, h] of letter.bars) bars.push([x + bx, by, w, h]);
  x += letter.advance;
}
const width = x - 5;
const style = [
  `width:${width}px`,
  `background-image:${bars.map(() => 'linear-gradient(currentColor,currentColor)').join(',')}`,
  `background-size:${bars.map(([, , w, h]) => `${w}px ${h}px`).join(',')}`,
  `background-position:${bars.map(([bx, by]) => `${bx}px ${by}px`).join(',')}`
].join(';');
---

<span class={`bar-mark ${cls}`} style={style} aria-hidden="true"></span>
<span class="sr-only">{text}</span>

<style>
  .bar-mark { display: block; height: 25px; background-repeat: no-repeat; color: var(--ink); flex: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>
