---
import Layout from '../layouts/Layout.astro';
import { latestRun } from '../lib/db';
import { num, pct, date } from '../lib/format';

const run = await latestRun();
Astro.response.headers.set('cache-control', 'public, max-age=300, s-maxage=3600');
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const median = run?.toolsTokens.median ?? 0;
const p90 = run?.toolsTokens.p90 ?? 0;
const p99 = run?.toolsTokens.p99 ?? 0;
const max = run?.toolsTokens.max ?? 0;
const heaviest = run?.heaviest[0];
const measured = run ? date(run.probedAt) : '';

const faq = [
  {
    q: 'How many context tokens does an MCP server cost?',
    a: `The median remote server in the official MCP registry costs ${num(median)} tokens of context per session for its tool definitions alone. The 90th percentile is ${num(p90)}, the 99th ${num(p99)}, and the heaviest server costs ${num(max)} tokens, more than two full 200k windows. Measured ${measured} across ${num(run?.ok ?? 0)} servers that answered.`
  },
  {
    q: 'Why does an MCP server cost tokens before I send a prompt?',
    a: 'A client sends the model the name, description and input schema of every tool from every connected server at the start of a session, and again on every turn. Those definitions are part of the prompt, so you pay for them in every request whether or not the model calls a tool.'
  },
  {
    q: 'How is the cost measured?',
    a: 'Each tool is serialised as compact JSON with name, description and input_schema and counted with the o200k_base tokenizer. Clients wrap tool definitions in slightly different ways and models tokenise differently, so the count is a floor, and it is the same floor for every server, which keeps servers comparable.'
  },
  {
    q: 'How many tokens does a specific MCP server cost?',
    a: `Every remote server in the registry has a page at ${site}/s/<registry name> with its measured cost, tool count and status. For a server that is not in the registry, ${site}/check probes it live. In a terminal, npx mcptop measures the servers in your own Claude Code, Claude Desktop, Cursor, VS Code or Windsurf config.`
  },
  {
    q: 'What is a reasonable budget?',
    a: `Half of all servers cost under ${num(median)} tokens. A config that adds up to a few thousand tokens is cheap. Above 20 000 tokens for one server, ask whether you need all of its tools; ${num(run ? run.heaviest.filter((h) => h.toolsTokens > 20_000).length : 0)} of the 20 heaviest servers alone exceed that. npx mcptop --budget 30000 fails a CI run when a config grows past a budget.`
  },
  {
    q: 'Does a server that needs auth cost tokens too?',
    a: 'Yes, once you are authenticated it hands over its tool definitions like any other. The board cannot list the tools of a server that refuses anonymous clients, so those servers show as “needs auth” without a count. mcptop measures them with the headers from your config.'
  }
];
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  dateModified: run?.probedAt
};
---

<Layout title="How many context tokens does an MCP server cost?" description={faq[0].a} jsonld={jsonld}>
  <p class="kicker">{run ? `${num(run.ok)} servers measured · ${measured}` : ''}</p>
  <h1 class="poster">How many context tokens does an MCP server cost?</h1>
  <p class="answer">{faq[0].a}</p>

  {run && (
    <div class="stats">
      <div class="stat"><b>{num(median)}</b><span>median tokens per server</span></div>
      <div class="stat"><b>{num(p90)}</b><span>90th percentile</span></div>
      <div class="stat"><b>{num(p99)}</b><span>99th percentile</span></div>
      <div class="stat"><b>{num(max)}</b><span>heaviest server</span></div>
      <div class="stat"><b>{num(run.toolCount.median)}</b><span>median tools per server</span></div>
      <div class="stat"><b>{pct(run.ok, run.probed)}</b><span>of registry servers answer at all</span></div>
    </div>
  )}

  {faq.slice(1).map((f) => (
    <>
      <h2>{f.q}</h2>
      <p>{f.a}</p>
    </>
  ))}

  {heaviest && (
    <>
      <h2>The heaviest servers right now</h2>
      <div class="frame">
        <table>
          <thead><tr><th>Server</th><th class="num">Tools</th><th class="num">Tokens</th><th class="num">Of 200k</th></tr></thead>
          <tbody>
            {run!.heaviest.slice(0, 10).map((s) => (
              <tr>
                <td class="break"><a href={`/s/${s.name}`}>{s.name}</a></td>
                <td class="num">{num(s.toolCount)}</td>
                <td class="num">{num(s.toolsTokens)}</td>
                <td class="num">{((s.toolsTokens / 200_000) * 100).toFixed(1)} %</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p><a href="/servers?sort=tokens">All servers by token cost →</a> · <a href="/statistics">Statistics →</a> · <a href="/methodology">Method →</a></p>
    </>
  )}
</Layout>
