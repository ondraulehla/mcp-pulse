---
import Layout from '../../layouts/Layout.astro';
import { getHistory, getServer, getSiblings } from '../../lib/db';
import { bucket, label, ms, num, tokens, date, windowShare } from '../../lib/format';

const name = Astro.params.name ?? '';
const server = await getServer(name);
if (!server) {
  return new Response('Not found', { status: 404 });
}
const [history, siblings] = await Promise.all([
  getHistory(name, 60),
  server.toolset_hash ? getSiblings(server.toolset_hash, name) : Promise.resolve([])
]);
Astro.response.headers.set('cache-control', 'public, max-age=300, s-maxage=3600');

const capabilities = server.capabilities ? (JSON.parse(server.capabilities) as string[]) : [];
const topTools = server.top_tools ? (JSON.parse(server.top_tools) as Array<{ name: string; tokens: number }>) : [];
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const badgeMd = `[![mcp-pulse](${site}/badge/${name}.svg)](${site}/s/${name})`;
const reachable = history.filter((h) => h.status === 'ok' || h.status === 'auth' || h.status === 'payment').length;
const heading = server.title ?? server.server_name ?? name;
const ok = server.status === 'ok';
const share = ok && server.tools_tokens ? ((server.tools_tokens / 200_000) * 100).toFixed(1) : null;
const pageTitle = ok
  ? `${name}: ${num(server.tools_tokens)} tokens of context, ${num(server.tool_count)} tools, alive`
  : `${name}: ${label(server.status)}`;
const answer = ok
  ? `Adding ${name} to an MCP client costs ${num(server.tools_tokens)} tokens of context per session: ${num(server.tool_count)} tool definitions, ${share} % of a 200k window, measured ${date(server.probed_at)}.`
  : `${name} did not answer the probe on ${date(server.probed_at)}: ${label(server.status)}${server.http_status ? ` (HTTP ${server.http_status})` : ''}.`;
const pageUrl = `${site}/s/${name}`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: heading,
  identifier: name,
  url: pageUrl,
  applicationCategory: 'MCP server',
  operatingSystem: 'Any',
  ...(server.server_version ? { softwareVersion: server.server_version } : {}),
  ...(server.description ? { description: server.description } : {}),
  ...(server.repo ? { codeRepository: server.repo } : {}),
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'status', value: label(server.status) },
    ...(ok ? [
      { '@type': 'PropertyValue', name: 'tool definitions token cost', value: server.tools_tokens, unitText: 'tokens (o200k_base)' },
      { '@type': 'PropertyValue', name: 'tools', value: server.tool_count },
      { '@type': 'PropertyValue', name: 'share of a 200k context window', value: Number(share), unitText: 'percent' }
    ] : []),
    ...(server.protocol_version ? [{ '@type': 'PropertyValue', name: 'MCP protocol version', value: server.protocol_version }] : [])
  ],
  dateModified: server.probed_at,
  isPartOf: { '@type': 'Dataset', name: 'mcp-pulse: health and token cost of the MCP registry', url: site, license: 'https://opensource.org/license/mit' }
};
---

<Layout title={pageTitle} description={answer} jsonld={jsonld}>
  <p class="kicker mono">{name}</p>
  <h1 class="poster">{heading}</h1>
  <p class="answer">{answer}</p>
  {server.description && <p class="muted">{server.description}</p>}

  <p style="margin-top:22px">
    <span class={`tag big ${bucket(server.status)}`}>{label(server.status)}</span>
    <span class="muted small"> probed {date(server.probed_at)}{server.http_status && <> · HTTP {server.http_status}</>}{server.auth_scheme && <> · {server.auth_scheme}</>}</span>
  </p>

  {server.status === 'ok' && (
    <div class="stats">
      <div class="stat"><b>{num(server.tool_count)}</b><span>tools</span></div>
      <div class="stat"><b>{tokens(server.tools_tokens)}</b><span>tokens for the tool definitions</span></div>
      <div class="stat"><b>{windowShare(server.tools_tokens)}</b><span>of a 200k context window</span></div>
      <div class="stat"><b>{ms(server.init_ms)}</b><span>to initialize</span></div>
      <div class="stat"><b>{ms(server.tools_ms)}</b><span>to list tools</span></div>
    </div>
  )}
  {server.status !== 'ok' && server.error && <pre>{server.error}</pre>}

  <dl class="facts">
    <dt>Endpoint</dt><dd class="mono">{server.url} <span class="faint">({server.transport})</span></dd>
    <dt>Host</dt><dd><a class="mono" href={`/servers?host=${encodeURIComponent(server.host)}`}>{server.host}</a></dd>
    {server.protocol_version && <><dt>Protocol</dt><dd class="mono">{server.protocol_version}</dd></>}
    {server.server_name && <><dt>Reports itself as</dt><dd>{server.server_name} {server.server_version}</dd></>}
    {capabilities.length > 0 && <><dt>Capabilities</dt><dd class="mono">{capabilities.join(', ')}</dd></>}
    {server.instructions_chars != null && server.status === 'ok' && <><dt>Instructions</dt><dd>{server.instructions_chars ? `${num(server.instructions_chars)} characters` : 'none'}</dd></>}
    {server.repo && <><dt>Repository</dt><dd><a href={server.repo} rel="noopener" class="break">{server.repo}</a></dd></>}
    {server.website && <><dt>Website</dt><dd><a href={server.website} rel="noopener" class="break">{server.website}</a></dd></>}
    <dt>Registry</dt><dd>{server.registry_status}, updated {date(server.registry_updated_at)} · <a href={`https://registry.modelcontextprotocol.io/v0/servers?search=${encodeURIComponent(name)}`} rel="noopener">registry entry</a></dd>
    {history.length > 0 && <><dt>Reachable</dt><dd>{reachable} of the last {history.length} probe{history.length === 1 ? '' : 's'}</dd></>}
  </dl>

  {topTools.length > 0 && (
    <>
      <h2>Most expensive tools</h2>
      <div class="frame">
        <table>
          <thead><tr><th>Tool</th><th class="num">Tokens</th><th class="num">Share of this server</th></tr></thead>
          <tbody>
            {topTools.map((t) => (
              <tr><td class="mono break">{t.name}</td><td class="num">{num(t.tokens)}</td><td class="num">{server.tools_tokens ? Math.round((t.tokens / server.tools_tokens) * 100) : 0} %</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {siblings.length > 0 && (
    <>
      <h2>Same tool set as {num(server.toolset_siblings)} other server{server.toolset_siblings === 1 ? '' : 's'}</h2>
      <p class="muted">These registry entries expose exactly the same tool names and schema sizes.</p>
      <ul>
        {siblings.map((s) => <li><a href={`/s/${s.name}`}>{s.name}</a> <span class="faint mono">{s.host}</span></li>)}
        {(server.toolset_siblings ?? 0) > siblings.length && <li class="muted">and {num((server.toolset_siblings ?? 0) - siblings.length)} more</li>}
      </ul>
    </>
  )}

  {history.length > 1 && (
    <>
      <h2>History</h2>
      <p class="muted small">A row is added when the result changes. A server that stays the same keeps its last row.</p>
      <div class="frame">
        <table>
          <thead><tr><th>Probed</th><th>Result</th><th class="num">Init</th><th class="num">Tools</th><th class="num">Tokens</th></tr></thead>
          <tbody>
            {history.map((h) => (
              <tr><td class="mono">{h.probed_at.slice(0, 16).replace('T', ' ')}</td><td><span class={`tag ${bucket(h.status)}`}>{label(h.status)}</span></td><td class="num">{ms(h.init_ms)}</td><td class="num">{num(h.tool_count)}</td><td class="num">{tokens(h.tools_tokens)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <h2>Badge</h2>
  <p><img src={`/badge/${name}.svg`} alt={`mcp-pulse: ${label(server.status)}`} height="20" /></p>
  <pre>{badgeMd}</pre>
</Layout>
