---
import Layout from '../layouts/Layout.astro';
import { latestRun, listHosts } from '../lib/db';
import { num, pct, tokens } from '../lib/format';

const [hosts, run] = await Promise.all([listHosts(500), latestRun()]);
const total = run?.probed ?? hosts.reduce((a, h) => a + h.servers, 0);
Astro.response.headers.set('cache-control', 'public, max-age=300, s-maxage=3600');
---

<Layout title="Hosts">
  <p class="kicker">{run ? `${num(run.hosts)} hosts · probed ${run.probedAt.slice(0, 10)}` : ''}</p>
  <h1 class="poster">Who publishes the registry</h1>
  <p class="lede">Probed servers, grouped by host name. “Distinct tool sets” is the number of different tool lists that one host serves.</p>
  <div class="frame hosts" style="margin-top:28px">
    <table>
      <thead>
        <tr><th>Host</th><th class="num">Servers</th><th class="num">Share</th><th class="num">Alive</th><th class="num">Gated</th><th class="num">Down</th><th class="num">Distinct tool sets</th><th class="num">Median tokens</th></tr>
      </thead>
      <tbody>
        {hosts.map((h) => (
          <tr>
            <td class="host"><a class="mono" href={`/servers?host=${encodeURIComponent(h.host)}`}>{h.host}</a></td>
            <td class="num">{num(h.servers)}</td>
            <td class="num">{pct(h.servers, total)}</td>
            <td class="num">{num(h.ok)}</td>
            <td class="num">{num(h.auth)}</td>
            <td class="num">{num(h.dead)}</td>
            <td class="num">{num(h.unique_toolsets)}</td>
            <td class="num">{tokens(h.median_tokens)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="muted small">The 500 biggest hosts of {num(run?.hosts ?? 0)}.</p>
</Layout>
