---
import Layout from '../layouts/Layout.astro';
import { latestRun } from '../lib/db';
import { num, pct, tokens, date } from '../lib/format';

const run = await latestRun();
Astro.response.headers.set('cache-control', 'public, max-age=300, s-maxage=3600');
const up = run?.ok ?? 0;
const gated = run ? (run.byStatus.auth ?? 0) + (run.byStatus.payment ?? 0) : 0;
const down = run ? run.probed - up - gated : 0;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
---

<Layout title="mcp-pulse">
  <p class="kicker">{run ? `${num(run.probed)} remote servers · probed ${date(run.probedAt)}` : 'no run yet'}</p>
  <h1 class="poster">Health and token cost of the MCP registry</h1>
  <p class="lede">Every remote server in the official registry, probed daily: does it answer, and how many tokens do its tool definitions cost before the first prompt.</p>

  <form class="filters check" method="get" action="/check">
    <label>Check a server
      <input type="text" name="target" placeholder="https://mcp.example.com/mcp or io.github.you/server" required autocomplete="off" />
    </label>
    <div class="actions"><button type="submit">Check</button></div>
  </form>

  {run && (
    <>
      <div class="stats">
        <div class="stat"><b>{pct(up, run.probed)}</b><span>alive</span></div>
        <div class="stat"><b>{pct(gated, run.probed)}</b><span>need auth or payment</span></div>
        <div class="stat"><b>{pct(down, run.probed)}</b><span>down or broken</span></div>
        <div class="stat"><b>{tokens(run.toolsTokens.median)}</b><span>median tokens per server</span></div>
        <div class="stat"><b>{tokens(run.toolsTokens.p90)}</b><span>90th percentile</span></div>
        <div class="stat"><b>{tokens(run.toolsTokens.max)}</b><span>heaviest server</span></div>
      </div>
      <div class="bar" role="img" aria-label={`${up} alive, ${gated} gated, ${down} down`}>
        <span class="up" style={`width:${(up / run.probed) * 100}%`}></span>
        <span class="gated" style={`width:${(gated / run.probed) * 100}%`}></span>
        <span class="down" style={`width:${(down / run.probed) * 100}%`}></span>
      </div>
      <div class="legend">
        <span><i style="background:var(--up)"></i>alive {num(up)}</span>
        <span><i style="background:var(--gated)"></i>needs auth or payment {num(gated)}</span>
        <span><i style="background:var(--accent)"></i>down or broken {num(down)}</span>
      </div>
    </>
  )}

  <nav class="links" aria-label="Sections">
    <a href="/servers">Servers<span>search, filter, sort</span></a>
    <a href="/statistics">Statistics<span>results, costs, protocols, publishers</span></a>
    <a href="/hosts">Hosts<span>who publishes what</span></a>
    <a href="/methodology">Method<span>how it is measured</span></a>
  </nav>

  <h2>Your own config</h2>
  <pre>npx mcptop</pre>
  <p class="muted small">Reads Claude Code, Claude Desktop, Cursor, VS Code and Windsurf configs, starts each server and prints the token cost. <code>--budget</code> for CI.</p>

  <h2>Badge</h2>
  <pre>{`[![mcp-pulse](${site}/badge/io.github.you/your-server.svg)](${site}/s/io.github.you/your-server)`}</pre>
</Layout>
