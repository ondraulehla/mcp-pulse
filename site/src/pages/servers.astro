---
import Layout from '../layouts/Layout.astro';
import Pager from '../components/Pager.astro';
import { latestRun, listServers, SORTS, DEFAULT_SORT, type SortKey } from '../lib/db';
import { bucket, label, ms, num, tokens, STATUS_LABEL } from '../lib/format';

const p = Astro.url.searchParams;
const q = (p.get('q') ?? '').trim().slice(0, 80);
const status = p.get('status') ?? '';
const host = p.get('host') ?? '';
const protocol = p.get('protocol') ?? '';
const transport = p.get('transport') ?? '';
const sort = (Object.keys(SORTS).includes(p.get('sort') ?? '') ? p.get('sort') : DEFAULT_SORT) as SortKey;
const page = Math.min(1000, Math.max(1, Number(p.get('page') ?? '1') || 1));

const [{ rows, hasNext, perPage }, run] = await Promise.all([
  listServers({ q, status, host, protocol, transport, sort, page }),
  latestRun()
]);
// A total is cheap only when it is already in the run summary.
const total =
  run && !q && !host && !protocol && !transport
    ? status === ''
      ? run.probed
      : status === 'down'
        ? run.probed - run.ok - (run.byStatus.auth ?? 0) - (run.byStatus.payment ?? 0) - (run.byStatus.newer_protocol ?? 0)
        : (run.byStatus[status] ?? 0)
    : null;
const pages = total !== null ? Math.max(1, Math.ceil(total / perPage)) : null;
const protocols = run ? Object.keys(run.protocols).filter((v) => v !== 'unknown').sort().reverse() : [];

Astro.response.headers.set('cache-control', 'public, max-age=120, s-maxage=1800');

const filtered = Boolean(q || status || host || protocol || transport);

/** Column headers: first click sorts the natural way (numbers high first, text A to Z), the second click flips. */
const columns: Array<{ label: string; first: SortKey; second: SortKey; num?: boolean }> = [
  { label: 'Server', first: 'name', second: 'name-desc' },
  { label: 'Result', first: 'status', second: 'status-desc' },
  { label: 'Tools', first: 'tools', second: 'tools-asc', num: true },
  { label: 'Claude', first: 'claude', second: 'claude-asc', num: true },
  { label: 'o200k', first: 'tokens', second: 'tokens-asc', num: true },
  { label: 'Init', first: 'latency', second: 'latency-desc', num: true },
  { label: 'Protocol', first: 'protocol-desc', second: 'protocol' },
  { label: 'Host', first: 'host', second: 'host-desc' }
];
function sortHref(key: SortKey): string {
  const u = new URL(Astro.url);
  u.searchParams.set('sort', key);
  u.searchParams.delete('page');
  return u.pathname + u.search;
}
function arrow(key: SortKey): string {
  return /-asc$|^latency$|^name$|^status$|^host$|^protocol$/.test(key) ? '▲' : '▼';
}
const title = host ? `Servers on ${host}` : status ? `${label(status)} servers` : q ? `Servers matching “${q}”` : 'Servers';
---

<Layout title={title}>
  <p class="kicker">{run ? `probed ${run.probedAt.slice(0, 10)}` : ''}</p>
  <h1 class="poster">{host ? host : status ? `${label(status)} servers` : q ? `Servers matching “${q}”` : 'Every remote server'}</h1>

  <form class="filters servers" method="get" action="/servers" role="search">
    <label>Search
      <input type="search" name="q" value={q} placeholder="name, title, description or host" autocomplete="off" />
    </label>
    <label>Result
      <select name="status">
        <option value="">any</option>
        <option value="ok" selected={status === 'ok'}>alive</option>
        <option value="auth" selected={status === 'auth'}>needs auth</option>
        <option value="payment" selected={status === 'payment'}>paid (402)</option>
        <option value="newer_protocol" selected={status === 'newer_protocol'}>newer protocol</option>
        <option value="down" selected={status === 'down'}>down or broken</option>
        <optgroup label="down, by cause">
          {Object.entries(STATUS_LABEL)
            .filter(([k]) => !['ok', 'auth', 'payment', 'newer_protocol'].includes(k))
            .map(([k, v]) => <option value={k} selected={status === k}>{v}</option>)}
        </optgroup>
      </select>
    </label>
    <label>Protocol
      <select name="protocol">
        <option value="">any</option>
        {protocols.map((v) => <option value={v} selected={protocol === v}>{v}</option>)}
      </select>
    </label>
    <label>Transport
      <select name="transport">
        <option value="">any</option>
        <option value="streamable-http" selected={transport === 'streamable-http'}>streamable http</option>
        <option value="sse" selected={transport === 'sse'}>sse</option>
      </select>
    </label>
    <label>Sort
      <select name="sort">
        {(Object.keys(SORTS) as SortKey[]).map((k) => <option value={k} selected={sort === k}>{SORTS[k].label}</option>)}
      </select>
    </label>
    {host && <input type="hidden" name="host" value={host} />}
    <div class="actions">
      <button type="submit">Filter</button>
      {filtered && <a class="clear" href="/servers">clear</a>}
    </div>
  </form>

  <p class="pager-label small muted" style="margin:14px 0 6px">
    {total !== null ? `${num(total)} servers` : rows.length ? `${num(rows.length)}${hasNext ? '+' : ''} servers on this page` : 'no servers'}{host && <> on {host}</>}{protocol && <> · {protocol}</>}{transport && <> · {transport}</>}{pages !== null && <> · page {page} of {num(pages)}</>}
  </p>
  <Pager page={page} pages={pages} hasNext={hasNext} url={Astro.url} position="top" />

  <div class="frame">
    <table>
      <thead>
        <tr>
          {columns.map((c) => {
            const active = sort === c.first || sort === c.second;
            const next = sort === c.first ? c.second : c.first;
            return (
              <th class={c.num ? 'num' : ''} aria-sort={active ? (arrow(sort) === '▲' ? 'ascending' : 'descending') : undefined}>
                <a class={`sort${active ? ' active' : ''}`} href={sortHref(next)} title={`Sort by ${SORTS[next].label}`}>{c.label}{active && <span class="arrow">{arrow(sort)}</span>}</a>
              </th>
            );
          })}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td class="break">
              <a href={`/s/${r.name}`}>{r.name}</a>
              {r.title && r.title !== r.name && <span class="sub">{r.title}</span>}
            </td>
            <td>
              <span class={`tag ${bucket(r.status)}`}>{label(r.status)}</span>
              {r.status === 'auth' && r.auth_scheme && <span class="sub">{r.auth_scheme}</span>}
              {(r.toolset_siblings ?? 0) > 0 && <span class="sub">same tools as {num(r.toolset_siblings)} other{r.toolset_siblings === 1 ? '' : 's'}</span>}
            </td>
            <td class="num">{num(r.tool_count)}</td>
            <td class="num" title={r.claude_tokens_cc != null ? `${num(r.claude_tokens_cc)} in Claude Code` : undefined}>{tokens(r.claude_tokens)}</td>
            <td class="num faint">{tokens(r.tools_tokens)}</td>
            <td class="num">{ms(r.init_ms)}</td>
            <td class="mono faint">{r.protocol_version ?? ''}</td>
            <td class="mono break"><a class="plain muted" href={`/servers?host=${encodeURIComponent(r.host)}`}>{r.host}</a></td>
          </tr>
        ))}
        {rows.length === 0 && <tr><td colspan="8" class="muted">Nothing matches.</td></tr>}
      </tbody>
    </table>
  </div>

  <Pager page={page} pages={pages} hasNext={hasNext} url={Astro.url} position="bottom" />
</Layout>
